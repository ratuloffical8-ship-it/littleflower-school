# .env.example
# Copy this file to ".env" (local) and fill in your values.
# On Render Static Site, add these same names in Environment settings.
#
# These are FRONTEND values. Firebase web config is public by design
# (it is NOT a secret), but security still depends on Firestore/Storage
# rules and the backend API. NEVER put service-account keys here.

# Firebase web app config (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Firebase App Check with reCAPTCHA v3 (site key only; the secret key stays in Firebase Console)
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key

# Optional: App Check debug token for local development only (leave empty in production)
VITE_APPCHECK_DEBUG_TOKEN=

# Backend API base URL (no trailing slash)
# Local example: http://localhost:8080
# Render example: https://your-api-name.onrender.com
VITE_API_BASE_URL=http://localhost:8080
