# server/.env.example
# Copy to "server/.env" for LOCAL development only. The real ".env" is git-ignored.
# On Render, set these in the Web Service > Environment tab. NEVER commit real values.
#
# These are BACKEND SECRETS/SETTINGS (unlike the frontend VITE_* values, which are public).

NODE_ENV=development
PORT=8080

# Allowed browser origin(s) for CORS. Comma-separate for more than one. No trailing slash.
# Local: http://localhost:5173   Production: your Render Static Site URL (https only)
FRONTEND_ORIGIN=http://localhost:5173

# Firebase project
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Service account (Firebase Console > Project settings > Service accounts > Generate new private key)
# Option A (Render): paste the whole JSON on ONE line, or its base64 encoding, into this variable.
# Option B (local only): leave this empty and set GOOGLE_APPLICATION_CREDENTIALS to the path of
#   the JSON file that is stored OUTSIDE the repository, e.g.
#   GOOGLE_APPLICATION_CREDENTIALS=C:\secure\tlfs-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# App Check enforcement (reCAPTCHA v3 tokens are verified on every public request).
# Keep "true" in production. Use "false" ONLY for local development.
APPCHECK_ENFORCE=true

# Number of reverse proxies in front of the API (Render = 1). Needed for correct per-IP rate limits.
TRUST_PROXY=1

# Maximum JSON request body size (e.g. 100kb)
JSON_BODY_LIMIT=100kb

# Lifetime of signed file URLs, in seconds
SIGNED_UPLOAD_URL_TTL_SECONDS=600
SIGNED_READ_URL_TTL_SECONDS=300
