# .gitignore

# Dependencies
node_modules/
server/node_modules/

# Build output
dist/
server/dist/
coverage/
*.tsbuildinfo

# Environment files (NEVER commit real values)
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# Firebase service account keys and secrets (NEVER commit)
serviceAccount*.json
*-firebase-adminsdk-*.json
service-account*.json
*.pem
*.key
secrets/

# Firebase local files
.firebase/
firebase-debug.log*
firestore-debug.log
ui-debug.log
.runtimeconfig.json

# Exports and backups that may contain real student data
exports/
backups/
*.backup.json

# Logs
logs/
*.log
npm-debug.log*

# Editor and OS files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
